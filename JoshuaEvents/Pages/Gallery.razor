@page "/gallery"

<PageTitle>Gallery - Joshua Events</PageTitle>

<div class="gallery-container">
    <section class="page-header">
        <div class="container">
            <h1>Our Work Gallery</h1>
            <p class="lead">Explore our recent events and decoration projects</p>
        </div>
    </section>

    <div class="container my-5">
        <div class="row mb-4">
            <div class="col-12">
                <div class="filter-buttons text-center">
                    <button class="btn @(activeFilter == "All" ? "btn-primary" : "btn-outline-primary") me-2" @onclick='() => FilterGallery("All")'>All</button>
                    <button class="btn @(activeFilter == "Photos" ? "btn-primary" : "btn-outline-primary") me-2" @onclick='() => FilterGallery("Photos")'>Photos</button>
                    <button class="btn @(activeFilter == "Videos" ? "btn-primary" : "btn-outline-primary") me-2" @onclick='() => FilterGallery("Videos")'>Videos</button>
                </div>
            </div>
        </div>

        @if (activeFilter == "All" || activeFilter == "Photos")
        {
            <h3 class="section-title mt-5 mb-4">Recent Event Photos</h3>
            <div class="row g-3">
                @foreach (var photo in galleryPhotos)
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="gallery-item">
                            <img src="@photo.ImageUrl" alt="@photo.Title" class="gallery-image" />
                            <div class="gallery-overlay">
                                <div class="gallery-info">
                                    <h5>@photo.Title</h5>
                                    <p>@photo.Category</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (activeFilter == "All" || activeFilter == "Videos")
        {
            <h3 class="section-title mt-5 mb-4">Event Videos</h3>
            <div class="row g-4">
                @foreach (var video in galleryVideos)
                {
                    <div class="col-md-6">
                        <div class="video-card">
                            <div class="video-thumbnail">
                                <img src="@video.ThumbnailUrl" alt="@video.Title" />
                                <div class="play-button">
                                    <i class="bi bi-play-circle-fill"></i>
                                </div>
                            </div>
                            <div class="video-info">
                                <h5>@video.Title</h5>
                                <p>@video.Description</p>
                                <span class="badge bg-primary">@video.Category</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <section class="gallery-cta">
        <div class="container text-center">
            <h3>Want to See Your Event Here?</h3>
            <p>Let us create beautiful memories for your special occasion</p>
            <a href="/contactus" class="btn btn-primary btn-lg">Get Started</a>
        </div>
    </section>
</div>

